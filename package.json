{
  "name": "movie-app",
  "version": "0.3.1",
  "description": "Offline local movie library and player",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Paul Fababeir",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --build && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --build",
    "test": "tsx --tsconfig tsconfig.node.json --test \"src/**/*.test.ts\"",
    "scan:report": "tsx scripts/scan-report.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "series:report": "tsx scripts/series-report.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.paulfababeir.movieapp",
    "productName": "Fabi+",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "movie-app-${version}-setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fabi+",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PaulFababeir",
        "repo": "movie-app"
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ]
  }
}
